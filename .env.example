# ─────────────────────────────────────────────────────────────
# atlas.core — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Variables prefixed with VITE_ are exposed to the client bundle.
# ─────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx

# ── Local / server-side only (do not expose with VITE_) ──────
# These are used by local scripts and Supabase edge functions.
# Keep them only in local secret files or Supabase/Vercel secret stores.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_US_MONTHLY_ATHLETE_PRO=
STRIPE_PRICE_US_YEARLY_ATHLETE_PRO=
STRIPE_PRICE_BR_MONTHLY_ATHLETE_PRO=
STRIPE_PRICE_BR_YEARLY_ATHLETE_PRO=

# Canonical app URL used by edge functions for emails and billing returns
APP_URL=https://useatlascore.com

# Optional comma-separated origin allowlist for Stripe checkout / billing portal redirects.
# Example:
# ALLOWED_REDIRECT_ORIGINS=https://useatlascore.com,http://127.0.0.1:4173
ALLOWED_REDIRECT_ORIGINS=

# ── Feature flags ────────────────────────────────────────────
# Enable admin + professional routes (coach, nutritionist, clinician)
VITE_ENABLE_PRO_ROUTES=false
# Enable remote ExerciseDB search through the Supabase edge function.
# Leave false in local dev to prefer the bundled exercise catalog.
VITE_ENABLE_REMOTE_EXERCISE_SEARCH=false

# ── Analytics — PostHog ──────────────────────────────────────
# Get from: PostHog → Project Settings → Project API Key
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Set to "true" to enable PostHog in local dev (disabled by default)
# VITE_POSTHOG_DEV=true

# ── Analytics — Meta / Facebook Pixel ────────────────────────
# Get from: Meta Events Manager → Data Sources → Your Pixel → Settings
VITE_META_PIXEL_ID=

# ── Analytics — Google Analytics 4 (optional) ────────────────
# Only needed if running Google Ads. PostHog + Vercel Analytics cover the base.
# Get from: GA4 → Admin → Data Streams → Your Stream → Measurement ID
VITE_GA_MEASUREMENT_ID=

# ── Error Monitoring — Sentry ────────────────────────────────
# Get from: Sentry → Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=

# ── Firebase Analytics (optional, web only) ──────────────────
# Only needed if using Firebase for push notifications or analytics.
# Native iOS/Android use GoogleService-Info.plist / google-services.json.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
