{
  "appId": "com.atlascore.app",
  "appName": "atlas.core",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 8000,
      "launchAutoHide": false,
      "launchFadeOutDuration": 200,
      "showSpinner": false,
      "backgroundColor": "#05070A",
      "splashImmersive": true,
      "splashFullScreen": true,
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#05070A"
    },
    "Keyboard": {
      "resize": "body",
      "style": "dark"
    }
  },
  "android": {
    "buildOptions": {
      "keystorePath": null,
      "keystorePassword": null,
      "keystoreAlias": null,
      "keystoreAliasPassword": null,
      "releaseType": "AAB"
    }
  },
  "ios": {
    "scheme": "atlascore",
    "contentInset": "never"
  }
}
