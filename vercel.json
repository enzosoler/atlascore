{
  "version": 2,
  "public": true,
  "outputDirectory": "dist",
  "framework": null,
  "buildCommand": "npm run build:dual",
  "installCommand": "npm install --legacy-peer-deps",
  "rewrites": [
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/br/:path*", "destination": "/br/index.html" },
    { "source": "/pt/:path*", "destination": "/index.html" },
    { "source": "/en/:path*", "destination": "/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/admin/:path*",
      "has": [{ "type": "host", "value": "(?!admin\\.).*useatlascore\\.com" }],
      "destination": "https://admin.useatlascore.com/admin/:path*",
      "permanent": false
    },
    {
      "source": "/:path((?!admin|_next|api|assets|favicon|branding|sw|workbox).*)",
      "has": [{ "type": "host", "value": "admin.useatlascore.com" }],
      "destination": "https://useatlascore.com/:path",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
