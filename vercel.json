{
  "version": 2,
  "public": true,
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/br/assets/(.*)", "destination": "/br/assets/$1" },
    { "source": "/br/(.*\\.(js|css|svg|png|ico|json))", "destination": "/br/$1" },
    { "source": "/br/(.*)", "destination": "/br/index.html" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/(.*\\.(js|css|svg|png|ico|json))", "destination": "/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
